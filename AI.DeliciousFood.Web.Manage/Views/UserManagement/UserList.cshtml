@using AI.DeliciousFood.Core.Common.ManageModel.UserManager
@* @model UserListViewModel
 *@
<!DOCTYPE html>
<html lang="zh">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta name="keywords" content="LightYear,LightYearAdmin,光年,后台模板,后台管理系统,光年HTML模板">
    <meta name="description" content="Light Year Admin V5是一个基于Bootstrap v5.1.3的后台管理系统的HTML模板。">
    <title>文档列表 - 光年(Light Year Admin V5)后台管理系统模板</title>
    <link rel="shortcut icon" type="image/x-icon" href="favicon.ico">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-touch-fullscreen" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="stylesheet" type="text/css" href="~/css/materialdesignicons.min.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.min.css" asp-append-version="true">
    <!--表格插件css-->
    <link rel="stylesheet" href="~/js/bootstrap-table/bootstrap-table.min.css" asp-append-version="true">
    <!--引入下拉插件css-->
    <link rel="stylesheet" type="text/css" href="~/js/bootstrap-select/bootstrap-select.min.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/style.min.css" asp-append-version="true">
    <!--日期选择器css-->
    <link rel="stylesheet" type="text/css" href="~/js/bootstrap-datepicker/bootstrap-datepicker3.min.css" asp-append-version="true">
</head>

<body>
    <div class="container-fluid">

        <div class="row">
            @await Html.PartialAsync("~/Views/Partial/EditUserModal.cshtml")
            <div class="col-lg-12">
                <div class="card">
                    <header class="card-header">
                        <div class="card-title">用户列表</div>
                    </header>
                    <div class="card-body">
                        <table id="table"></table>

                    </div>
                </div>
            </div>

        </div>

    </div>

    <script type="text/javascript" src="~/js/jquery.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/popper.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/bootstrap.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/main.min.js" asp-append-version="true"></script>
    <!--表格插件js-->
    <script src="~/js/bootstrap-table/bootstrap-table.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap-table/locale/bootstrap-table-zh-CN.min.js" asp-append-version="true"></script>
    <!--分页相关的配置-->
    <script src="~/viewjs/usermanagement/pagination.js" asp-append-version="true"></script>
    <!--引入下拉插件js-->
    <script type="text/javascript" src="~/js/bootstrap-select/bootstrap-select.min.js"></script>
    <script type="text/javascript" src="~/js/bootstrap-select/i18n/defaults-zh_CN.min.js"></script>
    <!--日期选择器js-->
    <script type="text/javascript" src="~/js/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script type="text/javascript" src="~/js/bootstrap-datepicker/locales/bootstrap-datepicker.zh-CN.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#datepicker').datepicker('setDate', new Date());
        });
        document.getElementById('saveButton').addEventListener('click', function() {
            // 在这里处理保存逻辑
            // 可以获取表单数据、发送请求到服务器等
            console.log('保存按钮点击');

            // 关闭模态框，可以选择在保存成功后关闭
            var myModal = bootstrap.Modal.getInstance(document.getElementById('editUserModal'));
            myModal.hide();
        });

            // 如果你需要在某个事件上简单获取值，比如按钮点击
        function getDateValue() {
            var dateValue = $('#datepicker').val();
            console.log("Selected date: ", dateValue);
        }
    </script>
</body>

</html>