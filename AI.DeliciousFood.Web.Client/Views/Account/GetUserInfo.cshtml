@using AI.DeliciousFood.Core.Common.Model.Account
@model GetUserInfoModel
@{
    ViewData["Title"] = "个人信息";
    Dictionary<string, string> roles = new Dictionary<string, string>
    {
        { "1", "管理员" },
        { "2", "普通用户" },
        { "3", "VIP用户" }
    };
    roles.TryGetValue(Model.UserInfoModel.RoleId, out var roleName);
}

@section Styles {
    <link href="~/css/account/getuserinfo.css" rel="stylesheet" />
}

<nav class="ai-nav-bar">
    <ol>
        <li>
            <span><a asp-controller="Home" asp-action="Index">首页</a></span>
        </li>
        <li>
            <span> > </span>
        </li>
        <li>
            <span>个人信息</span>
        </li>
    </ol>
</nav>

<hr />

<div class="container-fluid">
    <div class="row">
        <div class="card">
            <header class="card-header d-flex justify-content-between">
                <div class="card-title">我的资料</div>
                <ul class="card-actions">
                    <li><a href="#!" id=""><i class="mdi mdi-pen"></i></a></li>
                    <li><a href="#!" class="card-btn-slide"><i class="mdi mdi-chevron-up"></i></a></li>
                    <li><a href="#!" class="card-btn-fullscreen"><i class="mdi mdi-fullscreen"></i></a></li>
                </ul>
            </header>
            <div class="card-body">
                <form id="userForm">
                    <input id="id" value="@Model.UserInfoModel.Id" hidden />
                    <input type="hidden" id="roleId" name="roleId" value="@Model.UserInfoModel.RoleId">

                    <div class="mb-3">
                        <label for="userName" class="form-label">名称</label>
                        <input type="text" class="form-control" id="userName" placeholder="请输入您的名称" value="@Model.UserInfoModel.UserName" disabled>
                        <div class="text-danger" id="userNameError" style="display: none;"></div>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">电子邮件</label>
                        <input type="email" class="form-control" id="email" placeholder="请输入您的电子邮件" value="@Model.UserInfoModel.Email" disabled>
                        <div class="text-danger" id="emailError" style="display: none;"></div>
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">电话号码</label>
                        <input type="tel" class="form-control" id="phoneNumber" placeholder="请输入您的电话号码" value="@Model.UserInfoModel.PhoneNumber" disabled>
                        <div class="text-danger" id="phoneError" style="display: none;"></div>
                    </div>
                    <div class="mb-3">
                        <label for="role" class="form-label">角色</label>
                        <input type="text" class="form-control" value="@roleName" disabled>
                    </div>
                    <div class="mb-3">
                        <label for="membershipExpireAt" class="form-label">会员到期时间</label>
                        <input type="date" class="form-control" value="@Model.UserInfoModel.MembershipExpireAt" disabled>
                    </div>
                    <div class="mb-3">
                        <label for="createDateTime" class="form-label">账号创建时间</label>
                        <input type="datetime-local" class="form-control" value="@Model.UserInfoModel.CreateDateTime" disabled>
                    </div>
                </form>
            </div>
            <footer class="card-footer d-flex justify-content-between">
                <div class="form-check mt-2"></div>
                <div class="example-btn">
                    <button class="btn btn-primary" id="cancelButton" type="button" style="display: none;">取消</button>
                    <button class="btn btn-success" id="saveButton" type="button" style="display: none;">保存</button>
                </div>
            </footer>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="card">
            <header class="card-header d-flex justify-content-between">
                <div class="card-title">我的发布</div>
                <ul class="card-actions">
                    <li><a href="#!" class="card-btn-slide"><i class="mdi mdi-chevron-up"></i></a></li>
                    <li><a href="#!" class="card-btn-fullscreen"><i class="mdi mdi-fullscreen"></i></a></li>
                </ul>
            </header>
            <div class="card-body">
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @if (Model.Approved.Count > 0)
                    {
                        @foreach (var item in Model.Approved)
                        {
                            <div class="col">
                                <div class="card h-100" data-guid="@item.Guid" onclick="goToDetails(this)">
                                    <img src="../@item.ImageUrl/@item.FileName" class="card-img-top" alt="...">
                                    <div class="card-body">
                                        <h5 class="card-title">@item.RecipeName</h5>
                                        <p class="card-text">@item.RecipeDescription</p>
                                        <div class="details-btn">查看详情</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>"这里空空如也，发表一篇内容，让大家看到您的精彩分享！"</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="card">
            <header class="card-header d-flex justify-content-between">
                <div class="card-title">审核中（审核未通过）</div>
                <ul class="card-actions">
                    <li><a href="#!" class="card-btn-slide"><i class="mdi mdi-chevron-up"></i></a></li>
                    <li><a href="#!" class="card-btn-fullscreen"><i class="mdi mdi-fullscreen"></i></a></li>
                </ul>
            </header>
            <div class="card-body">
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @if (Model.UnderReviewOrNotApproved.Count > 0)
                    {
                        @foreach (var item in Model.UnderReviewOrNotApproved)
                        {
                            <div class="col">
                                <div class="card h-100" data-guid="@item.Guid" onclick="goToDetails(this)">
                                    <img src="../@item.ImageUrl/@item.FileName" class="card-img-top" alt="...">
                                    <div class="card-body">
                                        <h5 class="card-title">@item.RecipeName</h5>
                                        <p class="card-text">@item.RecipeDescription</p>
                                        <div class="details-btn">查看详情</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>"这里静悄悄的，看来还没有需要审核的内容！快去发布点什么吧！"</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="card">
            <header class="card-header d-flex justify-content-between">
                <div class="card-title">我的草稿</div>
                <ul class="card-actions">
                    <li><a href="#!" class="card-btn-slide"><i class="mdi mdi-chevron-up"></i></a></li>
                    <li><a href="#!" class="card-btn-fullscreen"><i class="mdi mdi-fullscreen"></i></a></li>
                </ul>
            </header>
            <div class="card-body">
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @if (Model.Draft.Count > 0)
                    {
                        @foreach (var item in Model.Draft)
                        {
                    <div class="col">
                        <div class="card h-100">
                            <img src="images/gallery/2.jpg" class="card-img-top" alt="...">
                            <div class="card-body">
                                <h5 class="card-title">僧宝传</h5>
                                <p class="card-text">禅宗自六祖以後，分而为二。一曰青原，其下为曹洞、云门、法眼；一曰南岳，其下为临济、沩仰。是为五宗。</p>
                            </div>
                        </div>
                    </div>
                        }
                    }
                    else
                    {
                        <p>"空空如也～ 不如动笔写点新鲜的内容？"</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!--卡片收缩-->
    <script src="~/js/lightyear/main.min.js"></script>
    <script src="~/js/account/getuserinfo.js" asp-append-version="true"></script>
}