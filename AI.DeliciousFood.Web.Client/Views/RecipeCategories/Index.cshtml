@using AI.DeliciousFood.Core.Common.Model.RecipeCategories
@model RecipeCategoriesIndexViewModel
@{
    ViewBag.Title = "菜谱分类";
    var grouped = Model.Categories.GroupBy(x => x.Category)
            .OrderBy(g => g.Key);
}

@section Styles {
    <link href="~/css/RecipeCategories/index.css" rel="stylesheet" asp-append-version="false" />
}

<div class="container mt-4">
    <div class="row">
        <!-- 左侧分类导航 -->
        <div class="col-3">
            <div class="list-group" id="category-list" style="max-height:80vh;overflow-y:auto;">
                <a href="#" class="list-group-item list-group-item-action category-link active" data-id="">
                    全部
                </a>
                @foreach (var group in grouped)
                {
                    <div class="mb-2">
                        <div class="fw-bold text-secondary small ps-2 py-1">@group.Key</div>
                        @foreach (var cat in group)
                        {
                            <a href="#" class="list-group-item list-group-item-action category-link"
                               data-id="@cat.Guid">
                                @cat.Name
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
        <!-- 右侧菜谱列表 -->
        <div class="col-9 d-flex flex-column" style="min-height: 580px;">
            <div class="flex-grow-1" id="recipe-content">
                <!-- 这里加载菜单列表 -->
                @await Html.PartialAsync("_RecipeList", Model.RecipeList)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/RecipeCategories/index.js" asp-append-version="false"></script>
}