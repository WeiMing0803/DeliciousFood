@section Styles{    
    <link href="~/css/menu/fileinput.css" rel="stylesheet" />
    <link href="~/css/radiogroup.css" rel="stylesheet" />
    <link href="~/lib/multiple-select/dist/multiple-select.min.css" rel="stylesheet" />
    <link href="~/lib/wangeditor/editor/dist/css/style.css" rel="stylesheet" />

    <link href="~/css/menu/index.css" rel="stylesheet" />
}

<nav class="ai-nav-menu">
    <ol>
        <li>
            <span><a asp-controller="Home" asp-action="Index">首页</a></span>
        </li>
        <li>
            <span> > </span>
        </li>
        <li>
            <span>编辑菜单</span>
        </li>
    </ol>
</nav>


<hr />

<form class="row g-3">
    <div class="mb-3">
        <label for="exampleFormControlInput1" class="form-label"></label>
        <input type="email" class="form-control" id="exampleFormControlInput1" placeholder="name@example.com">
    </div>
    <div class="mb-3">
        <label for="birthday">图片上传</label>
        <input id="file-1" name="file" type="file" multiple class="form-control" data-overwrite-initial="false" data-min-file-count="1" />
    </div>
    <div>
        <label for="exampleFormControlTextarea1" class="form-label">菜品描述</label>
        <textarea class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label for="birthday" class="form-label">制作难度</label>
        <fieldset tabindex="0" class='radioGroup'>
            <input id='g1o11' name="group0" value="option1" checked type="radio">
            <label for='g1o11'>简单</label>
            <input id='g1o21' name="group0" value="option2" type="radio">
            <label for='g1o21'>初级</label>
            <input id='g1o31' name="group0" value="option3" type="radio">
            <label for='g1o31'>中级</label>
            <input id='g1o41' name="group0" value="option4" type="radio">
            <label for='g1o41'>高级</label>
        </fieldset>
    </div>
    <div class="mb-3">
        <label for="birthday" class="form-label">需要时间</label>
        <fieldset tabindex="0" class='radioGroup'>
            <input id='g1o1' name="group1" value="option1" checked type="radio">
            <label for='g1o1'>十分钟</label>
            <input id='g1o2' name="group1" value="option2" type="radio">
            <label for='g1o2'>二十分钟</label>
            <input id='g1o3' name="group1" value="option3" type="radio">
            <label for='g1o3'>半小时</label>
            <input id='g1o4' name="group1" value="option4" type="radio">
            <label for='g1o4'>三刻钟</label>
            <input id='g1o5' name="group1" value="option5" type="radio">
            <label for='g1o5'>一小时</label>
            <input id='g1o6' name="group1" value="option6" type="radio">
            <label for='g1o6'>数小时</label>
            <input id='g1o7' name="group1" value="option7" type="radio">
            <label for='g1o7'>一天</label>
            <input id='g1o8' name="group1" value="option8" type="radio">
            <label for='g1o8'>数天</label>
        </fieldset>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label for="birthday" class="form-label">口味</label>
        </div>
        <div class="form-group">
            <select aria-label="Default select example">
                <option selected>Open this select menu</option>
                <option value="1">One</option>
                <option value="2">Two</option>
                <option value="3">Three</option>
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label for="birthday" class="form-label">烹饪工艺</label>
        </div>
        <div class="form-group">
            <select aria-label="Default select example">
                <option selected>Open this select menu</option>
                <option value="1">One</option>
                <option value="2">Two</option>
                <option value="3">Three</option>
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label for="birthday" class="form-label">使用厨具</label>
        </div>
        <div class="form-group">
            <select multiple="multiple">
                <option value="1">January</option>
                <option value="2">February</option>
                <option value="3">March</option>
                <option value="4">April</option>
                <option value="5">May</option>
                <option value="6">June</option>
                <option value="7">July</option>
                <option value="8">August</option>
                <option value="9">September</option>
                <option value="10">October</option>
                <option value="11">November</option>
                <option value="12">December</option>
            </select>
        </div>
    </div>
    <div class="mb-3">
        <label for="birthday">食材明细</label>
        <div class="row">
            <div class="col-md-6">
                <input type="text" class="form-control" placeholder="食材名称">
            </div>
            <div class="col-md-2">
                <input type="text" class="form-control" placeholder="用量">
            </div>
            <div class="col-md-2">
                <svg t="1697178067934" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="18351" width="32" height="32"><path d="M960.031235 159.921913v703.656418c0 52.974134-42.979014 95.953148-95.953148 95.953148h-703.656418c-52.974134 0-95.953148-42.979014-95.953148-95.953148v-703.656418c0-52.974134 42.979014-95.953148 95.953148-95.953148h703.656418c52.974134 0 95.953148 42.979014 95.953148 95.953148z m-831.593949-159.921913C57.771791 0 0.499756 57.272035 0.499756 127.937531v767.625183c0 70.665495 57.272035 127.937531 127.93753 127.93753h767.625183c70.665495 0 127.937531-57.272035 127.937531-127.93753v-767.625183c0-70.665495-57.272035-127.937531-127.937531-127.937531h-767.625183z" p-id="18352" fill="#3b7bff"></path><path d="M831.593948 513.149439c-0.499756 17.391508-15.192582 31.084822-32.684041 31.084822H559.726696c-8.795705 0-15.992191 7.196486-15.992191 15.992191v239.183211c0 17.391508-13.693314 32.184285-31.084822 32.684041-18.091166 0.499756-32.883943-13.993167-32.883944-31.984382V560.226452c0-8.795705-7.196486-15.992191-15.992191-15.992191H224.590337c-17.391508 0-32.184285-13.693314-32.684041-31.084822-0.499756-18.091166 13.993167-32.883943 31.984382-32.883944h239.88287c8.795705 0 15.992191-7.196486 15.992191-15.992191V225.090093c0-17.391508 13.693314-32.184285 31.084822-32.684041 18.091166-0.499756 32.883943 13.993167 32.883944 31.984382v239.88287c0 8.795705 7.196486 15.992191 15.992191 15.992191h239.88287c17.991215 0 32.484139 14.792777 31.984382 32.883944z" p-id="18353" fill="#3b7bff"></path></svg>
                <svg t="1697177914495" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="15671" width="32" height="32"><path d="M960.031235 159.921913v703.656418c0 52.974134-42.979014 95.953148-95.953148 95.953148h-703.656418c-52.974134 0-95.953148-42.979014-95.953148-95.953148v-703.656418c0-52.974134 42.979014-95.953148 95.953148-95.953148h703.656418c52.974134 0 95.953148 42.979014 95.953148 95.953148z m-831.593949-159.921913C57.771791 0 0.499756 57.272035 0.499756 127.937531v767.625183c0 70.665495 57.272035 127.937531 127.93753 127.93753h767.625183c70.665495 0 127.937531-57.272035 127.937531-127.93753v-767.625183c0-70.665495-57.272035-127.937531-127.937531-127.937531h-767.625183z" p-id="15672" fill="#d81e06"></path><path d="M799.609566 544.234261H223.890678c-17.691362 0-31.984383-14.293021-31.984382-31.984383s14.293021-31.984383 31.984382-31.984383h575.718888c17.691362 0 31.984383 14.293021 31.984382 31.984383s-14.293021 31.984383-31.984382 31.984383z" p-id="15673" fill="#d81e06"></path></svg>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label for="birthday">做法步骤</label>
        <div id="editor-wrapper">
            <div id="toolbar-container"><!-- 工具栏 --></div>
            <div id="editor-container"><!-- 编辑器 --></div>
        </div>
    </div>
    <div>
        <label for="exampleFormControlTextarea1" class="form-label">小窍门</label>
        <textarea class="form-control" rows="3"></textarea>
    </div>
    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-warning">保存草稿</button>
        <div class="mx-2"><!-- This div acts as a spacer --></div>
        <button type="submit" class="btn btn-primary">提交审核</button>
    </div>
</form>

@section Scripts{
    <script src="~/js/menu/fileinput.js"></script>
    <script src="~/js/menu/fileinput_locale_zh.js"></script>    
    <script src="~/lib/multiple-select/dist/multiple-select.min.js"></script>
    <script src="~/lib/wangeditor/editor/dist/index.js"></script>
    <script src="~/js/menu/menu.js"></script>
    <script>
        $(function () {
            $("select").multipleSelect();
        });
    </script>
}