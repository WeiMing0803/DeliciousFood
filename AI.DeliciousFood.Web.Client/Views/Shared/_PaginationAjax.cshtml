@using AI.DeliciousFood.Core.Common.Common
@model PaginationModel

<ul class="pagination justify-content-center">
    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
        <a class="page-link page-link-btn" href="#" data-page="@(Model.CurrentPage - 1)">上一页</a>
    </li>
    @if (Model.TotalPages <= 7)
    {
        for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link page-link-btn" href="#" data-page="@i">@i</a>
            </li>
        }
    }
    else
    {
        <li class="page-item @(Model.CurrentPage==1 ? "active" : "")">
            <a class="page-link page-link-btn" href="#" data-page="1">1</a>
        </li>
        @if (Model.CurrentPage > 4)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }
        for (var i = Math.Max(2, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages - 1, Model.CurrentPage + 2); i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link page-link-btn" href="#" data-page="@i">@i</a>
            </li>
        }
        @if (Model.CurrentPage < Model.TotalPages - 3)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }
        <li class="page-item @(Model.CurrentPage==Model.TotalPages ? "active" : "")">
            <a class="page-link page-link-btn" href="#" data-page="@Model.TotalPages">@Model.TotalPages</a>
        </li>
    }
    <li class="page-item @(Model.CurrentPage>=Model.TotalPages ? "disabled":"")">
        <a class="page-link page-link-btn" href="#" data-page="@(Model.CurrentPage + 1)">下一页</a>
    </li>
</ul>