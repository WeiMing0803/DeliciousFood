@using AI.DeliciousFood.Core.Common.Model.Logon
@model LogOnPageViewModel
@{
    Layout = null;
    var activeForm = ViewBag.ActiveForm;
    LoginViewModel loginModel = Model.LoginModel;
    RegisterViewModel registerModel = Model.RegisterModel;
    ForgotPasswordViewModel forgotModel = Model.ForgotModel;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>美食美刻</title>
    <link rel="shortcut icon" href="~/food.ico" type="image/x-icon" />
    <link href="~/css/logon/normalize.min.css" rel="stylesheet" />
    <link href="~/css/logon/logon.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div id="formContainer" data-active-form="@activeForm" class="dwo">
        <div class="formLeft">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logonlogo.png" />
            </a>
        </div>
        <div class="formRight">
            <!-- Forgot password form -->
            <form id="forgot" class="otherForm">
                <header>
                    <h1>忘记密码</h1>
                    <p>输入邮箱找回密码</p>
                </header>
                <section>
                    <label>
                        <p>邮箱</p>
                        <input asp-for="@forgotModel.Email" type="email" placeholder=" " />
                        <div class="border"></div>
                        <span asp-validation-for="@forgotModel.Email" class="text-danger"></span>
                    </label>
                    <button type="submit" id="sendEmailBtn">发送邮件</button>
                </section>
                <footer>
                    <button type="button" class="forgotBtn return">返回</button>
                </footer>
            </form>

            <!-- Login form -->
            <form id="login" asp-controller="AccountLogon" asp-action="Logon" method="post">
                @Html.AntiForgeryToken()
                <header>
                    <h1>欢迎回来</h1>
                    <p>请先登录</p>
                </header>
                <section>
                    <label>
                        <p>邮箱</p>
                        <input asp-for="@loginModel.Email" type="email" placeholder=" " value="youke@@qq.com" />
                        <div class="border"></div>
                        <span asp-validation-for="@loginModel.Email" class="text-danger"></span>
                    </label>
                    <label>
                        <p>密码</p>
                        <input asp-for="@loginModel.Password" type="password" placeholder=" " value="123456" />
                        <div class="border"></div>
                        <span asp-validation-for="@loginModel.Password" class="text-danger"></span>
                    </label>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <button type="submit">登 录</button>
                </section>
                <footer>
                    <button type="button" class="forgotBtn">忘记密码？</button>
                    <button type="button" class="registerBtn">新用户？</button>
                </footer>
            </form>

            <!-- Register form -->
            <form id="register" class="otherForm" asp-controller="AccountLogon" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <header>
                    <h1>用户注册</h1>
                    <p>注册后享受更多服务</p>
                </header>
                <section>
                    <label>
                        <p>用户名</p>
                        <input asp-for="@registerModel.UserName" type="text" placeholder=" " />
                        <div class="border"></div>
                        <span asp-validation-for="@registerModel.UserName" class="text-danger"></span>
                    </label>
                    <label>
                        <p>邮箱</p>
                        <input asp-for="@registerModel.Email" type="email" placeholder=" " />
                        <div class="border"></div>
                        <span asp-validation-for="@registerModel.Email" class="text-danger"></span>
                    </label>
                    <label>
                        <p>密码</p>
                        <input asp-for="@registerModel.Password" type="password" placeholder=" " />
                        <div class="border"></div>
                        <span asp-validation-for="@registerModel.Password" class="text-danger"></span>
                    </label>
                    <label>
                        <p>重复密码</p>
                        <input asp-for="@registerModel.ConfirmPassword" type="password" placeholder=" " />
                        <div class="border"></div>
                        <span asp-validation-for="@registerModel.ConfirmPassword" class="text-danger"></span>
                    </label>
                    <button type="submit">注 册</button>
                </section>
                <footer>
                    <button type="button" class="registerBtn return">返回</button>
                </footer>
            </form>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/logon/logon.js" asp-append-version="true"></script>
</body>
</html>