{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning" // 指定写入文件时仅限于Warning及以上级别的日志
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "SqlConnectionStrings": "Server=(localdb)\\MSSQLLocalDB;Database=DeliciousFood;Trusted_Connection=True;Pooling=true;MultipleActiveResultSets=True;"
}
